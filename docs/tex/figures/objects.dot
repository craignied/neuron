digraph neuron_objects {
  graph [rankdir=TB, bgcolor="transparent", margin=0.03, nodesep=0.20,
         ranksep=0.27, fontname="Helvetica", fontsize=10,
         label="Inheritance panel: open arrow means base class to derived class.     Service panel: arrow means calls or uses.",
         labelloc=b, labeljust=c];
  node [shape=box, style="rounded", color="#303030", fontname="Helvetica",
        fontsize=10, margin="0.09,0.05"];
  edge [color="#303030", fontname="Helvetica", fontsize=8, arrowsize=0.60];

  subgraph cluster_classes {
    label="A. Class inheritance";
    color="#808080";
    style="rounded";

    Model [label="Model"];
    Iterative [label="Iterative"];
    Network [label="Network"];
    OneHidden [label="OneHiddenNet"];
    Bare [label="BareProp"];
    Simple [label="SimpleProp"];
    Back [label="BackProp"];
    Logistic [label="Logistic"];
    DFA [label="DFA"];
    LDFA [label="LDFA"];
    QDFA [label="QDFA"];

    Model -> Iterative [arrowhead=empty, color="#305b8c"];
    Iterative -> Network [arrowhead=empty, color="#305b8c"];
    Network -> OneHidden [arrowhead=empty, color="#305b8c"];
    OneHidden -> Bare [arrowhead=empty, color="#305b8c"];
    OneHidden -> Simple [arrowhead=empty, color="#305b8c"];
    Network -> Back [arrowhead=empty, color="#305b8c"];
    Network -> Logistic [arrowhead=empty, color="#305b8c"];
    Model -> DFA [arrowhead=empty, color="#305b8c"];
    DFA -> LDFA [arrowhead=empty, color="#305b8c"];
    DFA -> QDFA [arrowhead=empty, color="#305b8c"];
  }

  subgraph cluster_services {
    label="B. Service dependencies";
    color="#808080";
    style="rounded";

    Gui [label="GUI handlers"];
    Main [label="process main"];
    Cli [label="neuronMain\nCLI driver"];
    Parse [label="util strict parsers"];
    Async [label="AsyncJob"];
    JobBody [label="GUI job body"];
    Guard [label="procguard"];

    CvCoord [label="CV coordinator"];
    Split [label="nsplit"];
    CV [label="crossval"];
    Adapters [label="cvadapters"];
    Eval [label="evaldesign"];
    Est [label="delong / clustered_auc"];
    Cov [label="auccov"];
    Report [label="cvreport"];

    OBD [label="obd"];
    RegressNet [label="RegressNet"];
    Factory [label="modelfactory"];
    Clone [label="netclone"];
    Auto [label="autoalgo"];
    Plateau [label="PlateauDetector"];

    ModelApi [label="Model API"];
    IterativeApi [label="Iterative API"];
    NetworkApi [label="Network API"];
    SimpleApi [label="SimpleProp API"];
    DfaApi [label="DFA API"];
    DataApi [label="DataSet API"];
    TwoSetApi [label="TwoSet API"];

    Gui -> Parse [label="validates fields"];
    Gui -> Async [label="launches long jobs"];
    Main -> Guard [label="calls"];
    Guard -> Cli [label="invokes body"];
    Cli -> ModelApi [label="drives"];

    Async -> JobBody [label="invokes safely"];
    JobBody -> NetworkApi [label="training"];
    JobBody -> OBD [label="sizing"];
    JobBody -> RegressNet [label="stepwise"];
    JobBody -> CvCoord [label="evaluation"];

    CvCoord -> Split [label="plans partitions"];
    CvCoord -> CV [label="runs procedures"];
    CvCoord -> Eval [label="chooses inference"];
    CvCoord -> Est [label="estimates AUC covariance"];
    CvCoord -> Report [label="renders results"];
    CV -> DataApi [label="materializes folds"];
    CV -> Adapters [label="invokes adapter-created Procedure"];
    Adapters -> NetworkApi [label="fits"];
    Adapters -> DfaApi [label="fits"];
    Adapters -> OBD [label="nested selection"];
    Est -> Cov [label="uses shared algebra"];

    DataApi -> TwoSetApi [label="owns metrics objects"];
    IterativeApi -> Plateau [label="uses"];
    OBD -> SimpleApi [label="grows and prunes"];
    RegressNet -> NetworkApi [label="clones and refits"];
    Factory -> NetworkApi [label="constructs"];
    Clone -> NetworkApi [label="clones"];
    Auto -> NetworkApi [label="probes clones"];
  }
}
